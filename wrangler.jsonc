{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-hn",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "5b60aa01-f196-40dd-a770-716b7b19e7a7","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "35b85605fa654bad8b63fc732a0495a6" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
